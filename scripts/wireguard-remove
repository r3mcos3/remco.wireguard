#!/bin/bash
# Deletes one WireGuard NetworkManager profile: wireguard-remove <uuid>.
# Only removes the NetworkManager connection profile -- the original .conf
# file the user imported from is untouched.
source "$(dirname -- "$0")/wireguard-common"

uuid="$1"

is_wireguard_uuid "$uuid" || fail "profile not found"
nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || fail "remove failed"

jq -nc '{ok:true}'
