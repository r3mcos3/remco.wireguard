#!/bin/bash
# One ping through a WireGuard tunnel, called on a slower cadence than
# wireguard-details (see BarWidget.qml) since it blocks for up to ~1.5s:
# wireguard-ping <interface>. Prints JSON; the widget keeps its own rolling
# window of these samples to derive a packet-loss percentage over time (a
# single ping can only ever read as 0% or 100% loss on its own).
source "$(dirname -- "$0")/wireguard-common"

iface="$1"

if ! valid_iface "$iface" || ! ip link show "$iface" &>/dev/null; then
  jq -nc --arg iface "$iface" '{iface: $iface, ok: false}'
  exit 0
fi

output=$(ping -c 1 -W 1 -I "$iface" 1.1.1.1 2>/dev/null)
ms=$(grep -oP 'time=\K[0-9.]+' <<<"$output")

if [[ -n "$ms" ]]; then
  jq -nc --arg iface "$iface" --argjson ms "$ms" '{iface: $iface, ok: true, ms: $ms}'
else
  jq -nc --arg iface "$iface" '{iface: $iface, ok: false}'
fi
